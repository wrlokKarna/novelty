{
    "name": "novelty",
    "version": "0.0.1",
    "type": "module",
    "description": "Novelty app electrobun: 1.18.4-beta.19",
    "scripts": {
        "start": "vite build && hutch electrobun dev",
        "start:edge": "vite build && bunx hutch-canary electrobun dev",
        "hmr": "vite --port 5173 --host",
        "dev": "vite build && hutch electrobun dev --watch",
        "dev:hmr": "concurrently \"bun run hmr\" \"bun run dev\"",
        "dev:edge": "bunx hutch-canary electrobun dev --watch",
        "build": "vite build && hutch electrobun build --env=stable",
        "build:edge": "vite build && bunx hutch-canary electrobun build --env=stable",
        "build:canary": "vite build && hutch electrobun build --env=canary",
        "build:canary:edge": "vite build && bunx hutch-canary electrobun build --env=canary",
        "type-check": "tsc --noEmit",
        "lint": "bunx eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@tabler/icons-react": "^3.50.0",
        "drizzle-orm": "^0.39.3",
        "electrobun": "^2.0.5",
        "framer-motion": "^12.43.0",
        "js-tiktoken": "^1.0.21",
        "novel": "^1.0.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.18.5",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "sqlite-vec": "^0.1.9",
        "vis-timeline": "^8.5.6",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/css": "^1.4.0",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.1",
        "@eslint/markdown": "^8.0.3",
        "@types/bun": "latest",
        "@types/node": "^26.6.6",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.6.2",
        "concurrently": "^9.2.5",
        "drizzle-kit": "^0.30.6",
        "eslint": "^10.14.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.13.0",
        "jiti": "^2.7.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5"
    }
}
