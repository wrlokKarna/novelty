{
    "name": "novelty",
    "version": "0.0.1",
    "type": "module",
    "description": "Novelty app electrobun: 1.18.4-beta.19",
    "scripts": {
        "start": "vite build && electrobun dev",
        "start:edge": "vite build && bunx hutch-canary electrobun dev",
        "dev": "electrobun dev --watch",
        "dev:edge": "bunx hutch-canary electrobun dev --watch",
        "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
        "hmr": "vite --port 5173 --host",
        "build:canary": "vite build && electrobun build --env=canary",
        "build:canary:edge": "vite build && bunx hutch-canary electrobun build --env=canary",
        "type-check": "tsc --noEmit",
        "lint": "bunx eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@tabler/icons-react": "^3.41.1",
        "drizzle-orm": "^0.39.3",
        "electrobun": "^1.18.1",
        "framer-motion": "^12.43.0",
        "js-tiktoken": "^1.0.21",
        "novel": "^1.0.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.14.2",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "sqlite-vec": "^0.1.9",
        "vis-timeline": "^8.5.1"
    },
    "devDependencies": {
        "@eslint/css": "^1.4.0",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.1",
        "@eslint/markdown": "^8.0.3",
        "@types/bun": "latest",
        "@types/node": "^26.2.0",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.5.0",
        "concurrently": "^9.2.1",
        "drizzle-kit": "^0.30.6",
        "eslint": "^10.9.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.11.0",
        "jiti": "^2.7.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^6.4.2",
        "vite-tsconfig-paths": "^6.1.1"
    }
}
